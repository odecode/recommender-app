import "std/os/proc_stat.bv";
import "std/os/time.bv";

obj ProcessObservation { stat: ProcStat; before_ns: Int; after_ns: Int; };
obj ProcessDelta {
    elapsed_ns: Int;
    cpu_ticks: Int;
    minor_faults: Int;
    major_faults: Int;
};

// Sample both sides of the OS read. Retain this uncertainty interval in raw
// output; a long collector pause must not look like an instantaneous sample.
defn process_observe(pid: Int) -> Result<ProcessObservation,Int> {
    let before: Result<Int,Int> = clock_ns_res(CLOCK_MONOTONIC);
    when is_err(before) { term Err(unwrap_err(before)); };
    let stat: Result<ProcStat,Int> = proc_stat_read(pid);
    when is_err(stat) { term Err(unwrap_err(stat)); };
    let after: Result<Int,Int> = clock_ns_res(CLOCK_MONOTONIC);
    when is_err(after) { term Err(unwrap_err(after)); };
    when unwrap(after) < unwrap(before) { term Err(0 - 22); };
    term Ok(ProcessObservation {
        stat: unwrap(stat), before_ns: unwrap(before), after_ns: unwrap(after)
    });
};

defn process_sample_midpoint(sample: ProcessObservation) -> Int {
    when sample.before_ns < 0 || sample.after_ns < sample.before_ns { trap; };
    term sample.before_ns + (sample.after_ns - sample.before_ns) / 2;
};

defn process_counters_valid(stat: ProcStat) -> Bool {
    term stat.pid > 0 && stat.start_ticks >= 0 && stat.user_ticks >= 0 &&
         stat.system_ticks >= 0 && stat.minor_faults >= 0 && stat.major_faults >= 0;
};

// Err(-22): identity changed, counter reset or non-increasing sample time.
// Err(-34): the sum of CPU deltas cannot be represented. No failed sample is
// converted to a zero-CPU or zero-memory observation.
defn process_delta(previous: ProcessObservation, current: ProcessObservation) -> Result<ProcessDelta,Int> {
    when !process_counters_valid(previous.stat) || !process_counters_valid(current.stat) { term Err(0 - 22); };
    when previous.stat.pid != current.stat.pid ||
         previous.stat.start_ticks != current.stat.start_ticks { term Err(0 - 22); };
    when previous.before_ns < 0 || previous.after_ns < previous.before_ns ||
         current.before_ns < previous.after_ns || current.after_ns < current.before_ns { term Err(0 - 22); };
    let elapsed: Int = process_sample_midpoint(current) - process_sample_midpoint(previous);
    when elapsed <= 0 { term Err(0 - 22); };
    when current.stat.user_ticks < previous.stat.user_ticks ||
         current.stat.system_ticks < previous.stat.system_ticks ||
         current.stat.minor_faults < previous.stat.minor_faults ||
         current.stat.major_faults < previous.stat.major_faults { term Err(0 - 22); };
    let user_ticks: Int = current.stat.user_ticks - previous.stat.user_ticks;
    let system_ticks: Int = current.stat.system_ticks - previous.stat.system_ticks;
    when user_ticks > 9223372036854775807 - system_ticks { term Err(0 - 34); };
    term Ok(ProcessDelta {
        elapsed_ns: elapsed, cpu_ticks: user_ticks + system_ticks,
        minor_faults: current.stat.minor_faults - previous.stat.minor_faults,
        major_faults: current.stat.major_faults - previous.stat.major_faults
    });
};
