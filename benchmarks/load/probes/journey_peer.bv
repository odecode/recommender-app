import "../journey_wire.bv";

defn probe_frame(opcode: Int, masked: Bool, fin: Bool, text: String) -> String {
    let frame: GrowBuf = ws_encode(grow_new(128),fin,opcode,masked,0,((text as Data) as Int)+8,text .^Length);
    let value: String = buf_slice_string(ByteBuf { ptr: frame.ptr, len: frame.len, cap: frame.cap },0,frame.len);
    grow_free(frame); term value;
};
defn probe_serve(wire: JourneyWire, mode: Int) -> Bool {
    let header_done: Bool = false;
    let key: String = "";
    foreach turn in 0..4096 {
        when !header_done {
            when !journey_receive(wire) { term false; };
            let text: String = buf_slice_string(wire.bytes,0,wire.bytes.len);
            let boundary: Int = str_find(text,"\r\n\r\n");
            when boundary >= 0 {
                let parsed: HttpParse = http_parse_request(wire.bytes,wire.bytes.len);
                when parsed.status != HTTP_COMPLETE { term false; };
                key = http_header(parsed.request,"Sec-WebSocket-Key");
                header_done = true; journey_consume(wire,boundary+4);
            };
        };
    };
    when !header_done { term false; };
    let accept: String = ws_accept_key(key);
    when mode == 7 { accept = "invalid"; };
    let reply: String = "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\nSec-WebSocket-Accept: "+accept+"\r\n\r\n";
    let frame: String = probe_frame(WS_OP_TEXT,mode == 2,mode != 3,"server-probe");
    when mode == 4 { frame = frame[0:frame .^Length-1]; };
    when mode == 6 { frame = probe_frame(WS_OP_PING,false,true,"ping")+frame; };
    when mode == 5 { frame = ""; };
    reply = reply+frame;
    when mode == 1 {
        foreach index in 0..reply .^Length {
            when !journey_send(wire,reply[index:index+1]) { term false; };
            sleep_ms(1);
        };
    };
    when mode != 1 && !journey_send(wire,reply) { term false; };
    when mode == 5 { sleep_ms(700); term true; };
    // The successful cases also independently inspect the client's masking.
    when mode == 0 || mode == 1 || mode == 6 {
        foreach turn in 0..1000 {
            let decoded: Result<WsFrame,String> = ws_decode(wire.bytes,0);
            when is_ok(decoded) && ws_frame_fits(wire.bytes,0,unwrap(decoded)) {
                let header: WsFrame = unwrap(decoded);
                let message: WsMessage = ws_message(wire.bytes,0);
                term header.masked && header.fin && message.opcode == WS_OP_TEXT && message.payload == "client-probe";
            };
            when !journey_receive(wire) { term false; };
        };
        term false;
    };
    term true;
};
let done: Bool = false;
node main [!done][done] {
    let listener: Socket = sock_tcp_nonblocking();
    when listener.fd < 0 || sock_bind_listen(listener,get_env_int!("LOAD_PORT"),4) < 0 { endprogram 1; };
    let polls: PollSet = unwrap(poll_new(1)); poll_set(polls,0,listener.fd,POLL_IN);
    println!("peer_ready"); stdout_flush();
    when poll_wait(polls,5000) <= 0 { endprogram 2; };
    let socket: Socket = sock_accept(listener);
    when socket.fd < 0 { endprogram 3; };
    let wire: JourneyWire = JourneyWire { socket: socket, polls: unwrap(poll_new(1)), bytes: buf_new(266240), deadline: now_ns()+3000000000, error: "" };
    let good: Bool = probe_serve(wire,get_env_int!("PEER_MODE"));
    journey_close(wire); poll_free(polls); sock_close(listener);
    done = true; when !good { endprogram 4; }; endprogram;
};
