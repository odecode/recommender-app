import "../journey_oracle.bv";

defn oracle_event(kind: String, revision: String, extra: String) -> String {
    term "{\"v\":1,\"type\":\""+kind+"\",\"server_epoch\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"account_id\":7,\"revision\":\""+revision+"\","+extra+"}";
};
defn oracle_stages() -> JourneyStages { term JourneyStages { accepted: false, saved: false, predicted: false, failed: false }; };
let done: Bool = false;
node main [!done][done] {
    let expected: JourneyExpectation = JourneyExpectation { epoch: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", account: 7,
        revision: "5", generation: "1", operation: "op", item: 4, rating: 5, rated_count: 5, items: 1682 };
    let accepted: String = oracle_event("accepted","5","\"operation_id\":\"op\",\"item_id\":4,\"rating\":5");
    let saved: String = oracle_event("saved","5","\"operation_id\":\"op\"");
    let movies: String = "[{\"item_id\":5,\"score\":5},{\"item_id\":6,\"score\":4},{\"item_id\":7,\"score\":3},{\"item_id\":8,\"score\":2},{\"item_id\":9,\"score\":1}]";
    let fields: String = "\"model_generation\":\"1\",\"job_id\":\"8\",\"attempt\":1,\"cold_start\":false,\"recommendations\":"+movies;
    let prediction: String = oracle_event("recommendations","5",fields);
    let stages: JourneyStages = oracle_stages();
    when journey_event(accepted,expected,stages) != 1 || journey_complete(stages) { endprogram 1; };
    when journey_event(prediction,expected,stages) != 1 || journey_complete(stages) { endprogram 2; };
    when journey_event(saved,expected,stages) != 1 || !journey_complete(stages) { endprogram 3; };
    when journey_event(saved,expected,stages) != 1 || !journey_complete(stages) { endprogram 4; };
    let reversed: JourneyStages = oracle_stages();
    journey_event(saved,expected,reversed); journey_event(accepted,expected,reversed);
    when journey_complete(reversed) { endprogram 5; };
    journey_event(prediction,expected,reversed);
    when !journey_complete(reversed) { endprogram 6; };
    let stale: JourneyStages = oracle_stages();
    when journey_event(oracle_event("recommendations","4",fields),expected,stale) != 0 || stale.predicted { endprogram 7; };
    when journey_event(oracle_event("saved","5","\"operation_id\":\"other\""),expected,stale) != 0 || stale.saved { endprogram 8; };
    let wrong: JourneyStages = oracle_stages();
    when journey_event(oracle_event("accepted","5","\"operation_id\":\"op\",\"item_id\":4,\"rating\":4"),expected,wrong) != -1 || !wrong.failed { endprogram 9; };
    let duplicate: JourneyStages = oracle_stages();
    when journey_event(oracle_event("recommendations","5",fields+",\"model_generation\":\"1\""),expected,duplicate) != -1 { endprogram 10; };
    let failed: JourneyStages = oracle_stages();
    when journey_event(oracle_event("save-failed","5","\"operation_id\":\"op\""),expected,failed) != -1 { endprogram 11; };
    journey_event(accepted,expected,failed); journey_event(saved,expected,failed); journey_event(prediction,expected,failed);
    when journey_complete(failed) { endprogram 12; };
    when journey_ranked(journey_document("[{\"item_id\":0,\"score\":5}]"),expected) { endprogram 13; };
    when journey_positive("01") || journey_positive("9223372036854775808") || !journey_positive("9223372036854775807") { endprogram 14; };
    expected.generation = "2";
    let old_model: JourneyStages = oracle_stages();
    when journey_event(prediction,expected,old_model) != -1 || !old_model.failed { endprogram 16; };
    expected.generation = "1";
    expected.account = 8;
    let wrong_owner: JourneyStages = oracle_stages();
    when journey_event(saved,expected,wrong_owner) != 0 || wrong_owner.saved { endprogram 17; };
    expected.account = 7; expected.epoch = "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb";
    when journey_event(saved,expected,wrong_owner) != 0 || wrong_owner.saved { endprogram 18; };
    expected.epoch = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa";
    let repeated: String = "[{\"item_id\":5,\"score\":5},{\"item_id\":6,\"score\":4},{\"item_id\":5,\"score\":3},{\"item_id\":8,\"score\":2},{\"item_id\":9,\"score\":1}]";
    when journey_ranked(journey_document(repeated),expected) { endprogram 19; };
    expected.items = 9;
    when journey_ranked(journey_document(movies),expected) { endprogram 20; };
    expected.items = 1682;
    let malformed: JourneyStages = oracle_stages();
    when journey_event(saved+"trailing",expected,malformed) != -1 { endprogram 21; };
    expected.rated_count = 4;
    when !journey_ranked(journey_document("[]"),expected) || journey_ranked(journey_document(movies),expected) { endprogram 15; };

    // 2026-11-07: revisions are a global server clock. Learn this account's
    // next revision from its own acceptance, then keep later event validation
    // strict; another account's revision must never unlock the expectation.
    let learner: JourneyExpectation = JourneyExpectation { epoch: "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", account: 7,
        revision: "", generation: "1", operation: "learn-op", item: 4, rating: 5, rated_count: 1, items: 1682 };
    let global_accepted: String = oracle_event("accepted","92","\"operation_id\":\"learn-op\",\"item_id\":4,\"rating\":5");
    when journey_accepted_revision(global_accepted,learner) != "92" { endprogram 22; };
    learner.revision = journey_accepted_revision(global_accepted,learner);
    let learned: JourneyStages = oracle_stages();
    when journey_event(global_accepted,learner,learned) != 1 || !learned.accepted { endprogram 23; };
    when journey_event(oracle_event("saved","92","\"operation_id\":\"learn-op\""),learner,learned) != 1 || !learned.saved { endprogram 24; };
    when journey_event(oracle_event("saved","93","\"operation_id\":\"learn-op\""),learner,learned) != 0 { endprogram 25; };
    learner.account = 8;
    when journey_accepted_revision(global_accepted,learner) .^Length != 0 { endprogram 26; };
    learner.account = 7; learner.operation = "other-op";
    when journey_accepted_revision(global_accepted,learner) .^Length != 0 { endprogram 27; };
    learner.operation = "learn-op";
    when journey_accepted_revision(oracle_event("accepted","0","\"operation_id\":\"learn-op\",\"item_id\":4,\"rating\":5"),learner) .^Length != 0 ||
        journey_accepted_revision(oracle_event("accepted","92","\"operation_id\":\"learn-op\",\"item_id\":4,\"rating\":5,\"revision\":\"93\""),learner) .^Length != 0 { endprogram 28; };
    when journey_rejection("{\"error\":\"worker-busy\",\"message\":\"retry\"}") != "worker-busy" ||
        journey_rejection("{\"error\":\"operation-pending\",\"message\":\"resolve\"}") != "operation-pending" { endprogram 29; };
    when journey_rejection("{\"error\":\"validation\",\"message\":\"bad\"}") .^Length != 0 ||
        journey_rejection("{\"v\":1,\"error\":\"worker-busy\",\"message\":\"retry\"}") .^Length != 0 ||
        journey_rejection("{\"error\":\"worker-busy\",\"error\":\"operation-pending\",\"message\":\"retry\"}") .^Length != 0 { endprogram 30; };
    println!("journey_oracle_ok"); done = true; endprogram;
};
