import "../journey_pool.bv";

// Synthetic multi-user accounting gate: no network. Three bounded journeys
// cover a complete journey with every definite rating outcome, an uncertain
// loss after the rating stage begins, and a mid-journey stage failure.
defn stage_run(slot: UserSlot, accounting: JourneyAccounting, stage: Int) -> Void {
    user_stage_start(slot,accounting,stage,slot.stage_started_ns+5);
    user_stage_done(slot,accounting,slot.stage_started_ns+100);
};

defn stages_five(slot: UserSlot, accounting: JourneyAccounting) -> Void {
    stage_run(slot,accounting,JR_REGISTER);
    stage_run(slot,accounting,JR_LOGIN);
    stage_run(slot,accounting,JR_HYDRATE);
    stage_run(slot,accounting,JR_CATALOGUE);
    stage_run(slot,accounting,JR_UPGRADE);
};

// Re-delivered accepted/saved/prediction events for a settled slot are
// inert: no phase histogram may gain a second sample (duplicates happen on
// the profile channel).
defn rating_duplication_inert(slot: UserSlot, accounting: JourneyAccounting) -> Void {
    let admission: Int = accounting.phase_admission.count;
    let save: Int = accounting.phase_save.count;
    let prediction: Int = accounting.phase_prediction.count;
    rating_accepted(slot,accounting,9999);
    rating_saved(slot,accounting,9999);
    rating_predicted(slot,accounting,9999);
    when accounting.phase_admission.count != admission || accounting.phase_save.count != save ||
        accounting.phase_prediction.count != prediction { trap; };
};

let done: Bool = false;
node main [!done][done] {
    let accounting: JourneyAccounting = journey_accounting();
    // Four offered arrivals, one consumed by bounded capacity: missed.
    accounting_arrival(accounting,4,3);
    let alpha: UserSlot = user_slot(0);
    let beta: UserSlot = user_slot(1);
    let gamma: UserSlot = user_slot(2);
    user_arrive(alpha,accounting,1000,1100);
    user_arrive(beta,accounting,1000,1200);
    user_arrive(gamma,accounting,2000,2300);
    when accounting.running != 3 || accounting.offered != 4 || accounting.missed != 1 { endprogram 1; };

    // Alpha: every stage, then five serial ratings covering each definite
    // outcome, then logout. Accounting owns counts and instants; the driver
    // owns identity fields, learned revisions and slot.rated progression.
    stages_five(alpha,accounting);
    user_stage_start(alpha,accounting,JR_RATINGS,1630);
    rating_begin(alpha,accounting,2000,2050);
    rating_accepted(alpha,accounting,2100);
    rating_saved(alpha,accounting,2150);
    rating_predicted(alpha,accounting,2200);
    rating_finish(alpha,accounting,RAT_OK,2250);
    alpha.rated = 1;
    rating_duplication_inert(alpha,accounting);
    rating_begin(alpha,accounting,2300,2300);
    rating_finish(alpha,accounting,RAT_REJECTED,2350);
    rating_duplication_inert(alpha,accounting);
    rating_begin(alpha,accounting,2400,2405);
    rating_accepted(alpha,accounting,2455);
    rating_finish(alpha,accounting,RAT_TRANSPORT,2500);
    rating_duplication_inert(alpha,accounting);
    rating_begin(alpha,accounting,2600,2605);
    rating_accepted(alpha,accounting,2655);
    rating_saved(alpha,accounting,2705);
    rating_predicted(alpha,accounting,2708);
    rating_finish(alpha,accounting,RAT_OK,2710);
    alpha.rated = 2;
    rating_duplication_inert(alpha,accounting);
    rating_begin(alpha,accounting,2800,2805);
    rating_finish(alpha,accounting,RAT_TIMEOUT,3400);
    rating_duplication_inert(alpha,accounting);
    user_stage_done(alpha,accounting,3405);
    user_stage_start(alpha,accounting,JR_LOGOUT,3410);
    user_stage_done(alpha,accounting,3610);
    when alpha.rated != 2 || alpha.active || alpha.pending { endprogram 2; };

    // Beta reaches the rating stage and loses the connection with a pending
    // rating: the operation is counted uncertain, never measured, and the
    // journey fails.
    stages_five(beta,accounting);
    user_stage_start(beta,accounting,JR_RATINGS,1730);
    rating_begin(beta,accounting,1800,1805);
    user_stage_fail(beta,accounting,"connection-lost",1815);
    when beta.active || beta.status != JR_FAILED || beta.pending { endprogram 3; };

    // Gamma fails during hydration; no rating is pending.
    stage_run(gamma,accounting,JR_REGISTER);
    stage_run(gamma,accounting,JR_LOGIN);
    user_stage_start(gamma,accounting,JR_HYDRATE,2515);
    user_stage_fail(gamma,accounting,"server-restart",2615);

    when accounting.running != 0 || accounting.completed != 1 || accounting.failed != 2 { endprogram 4; };
    // Stage tallies across the three journeys.
    when accounting.stage_started[1] != 3 || accounting.stage_done[1] != 3 || accounting.stage_failed[1] != 0 { endprogram 5; };
    when accounting.stage_started[2] != 3 || accounting.stage_done[2] != 3 { endprogram 6; };
    when accounting.stage_started[3] != 3 || accounting.stage_done[3] != 2 || accounting.stage_failed[3] != 1 { endprogram 7; };
    when accounting.stage_started[4] != 2 || accounting.stage_done[4] != 2 { endprogram 8; };
    when accounting.stage_started[5] != 2 || accounting.stage_done[5] != 2 { endprogram 9; };
    when accounting.stage_started[6] != 2 || accounting.stage_done[6] != 1 || accounting.stage_failed[6] != 1 { endprogram 10; };
    when accounting.stage_started[7] != 1 || accounting.stage_done[7] != 1 { endprogram 11; };
    // Rating outcomes and the separate phase denominators.
    when accounting.ratings_started != 6 || accounting.ratings_done != 6 || accounting.ratings_inflight != 0 { endprogram 12; };
    when accounting.ratings_ok != 2 || accounting.ratings_rejected != 1 || accounting.ratings_transport != 1 ||
        accounting.ratings_timed_out != 1 || accounting.ratings_validation != 0 ||
        accounting.ratings_uncertain != 1 { endprogram 13; };
    when accounting.phase_admission.count != 3 || accounting.phase_save.count != 2 ||
        accounting.phase_prediction.count != 2 { endprogram 14; };
    // Definite durations only: the uncertain beta loss contributed no sample.
    when accounting.rating_duration.count != 5 || accounting.rating_duration.overflow != 0 ||
        accounting.rating_duration.maximum != 600 { endprogram 15; };
    // All synthetic durations sit inside the first one-millisecond bin.
    when histogram_quantile(accounting.rating_duration,900) != 999999 ||
        histogram_quantile(accounting.phase_admission,900) != 999999 { endprogram 16; };
    when !journey_accounting_consistent(accounting) { endprogram 17; };
    // Rating timestamps must not erase the intended journey arrival or its lag.
    when accounting.arrival_lag.count != 3 || accounting.arrival_lag.maximum != 300 ||
        alpha.arrival_scheduled_ns != 1000 || alpha.arrival_started_ns != 1100 { endprogram 18; };
    println!("pool,offered,missed,completed,failed");
    println!("pool,{},{},{},{},{}",accounting.offered,accounting.missed,accounting.completed,accounting.failed,accounting.running);
    println!("ratings,started,done,inflight,ok,rejected,transport,timeout,validation,uncertain,duration_count");
    println!("ratings,{},{},{},{},{},{},{},{},{},{}",accounting.ratings_started,
        accounting.ratings_done,accounting.ratings_inflight,accounting.ratings_ok,
        accounting.ratings_rejected,accounting.ratings_transport,accounting.ratings_timed_out,
        accounting.ratings_validation,accounting.ratings_uncertain,accounting.rating_duration.count);
    println!("journey_pool_ok");
    done = true;
    endprogram;
};
