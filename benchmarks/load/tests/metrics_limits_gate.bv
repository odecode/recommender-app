import "../metrics.bv";
let done: Bool = false;
node main [!done][done] {
    let scenario: Int = get_env_int!("CASE");
    when scenario == 1 { operation_metrics(0,100,10); };
    let metrics: OperationMetrics = operation_metrics(1,100,10);
    let other: OperationMetrics = operation_metrics(2,100,10);
    let slot: AttemptSlot = attempt_slot();
    when scenario == 2 { attempt_finish(slot,metrics,100,OUTCOME_OK); };
    when scenario == 3 { attempt_begin(slot,metrics,0 - 1,100); };
    when scenario == 4 { attempt_begin(slot,metrics,101,100); };
    when scenario == 5 {
        metrics.started = 9223372036854775807;
        attempt_begin(slot,metrics,0,100);
    };
    attempt_begin(slot,metrics,0,100);
    when scenario == 6 { attempt_begin(slot,metrics,0,100); };
    when scenario == 7 { attempt_finish(slot,other,200,OUTCOME_OK); };
    when scenario == 8 { attempt_finish(slot,metrics,99,OUTCOME_OK); };
    when scenario == 9 { attempt_finish(slot,metrics,200,0); };
    when scenario == 10 { attempt_finish(slot,metrics,200,6); };
    attempt_finish(slot,metrics,200,OUTCOME_OK);
    when scenario == 11 { attempt_finish(slot,metrics,200,OUTCOME_OK); };
    println!("metrics_valid_limits_ok");
    done = true;
    endprogram;
};
