import "std/net/nonblocking.bv";
import "std/net/http_response.bv";
import { buf_slice_string } from "std/net/http.bv";
import "std/os/poll.bv";
import "std/os/time.bv";
import "./metrics.bv";
import "./catalogue.bv";

obj HttpAttempt {
    attempt: AttemptSlot; socket: Socket; response: ByteBuf;
    frame: HttpResponseFrame; state: Int; sent: Int; deadline: Int;
};

defn http_attempt_new() -> HttpAttempt {
    term HttpAttempt { attempt: attempt_slot(), socket: Socket { fd: -1 },
        response: buf_new(266240), frame: http_response_frame(4096,262144),
        state: 0, sent: 0, deadline: 0 };
};

defn http_attempt_finish(slot: HttpAttempt, metrics: OperationMetrics, outcome: Int) -> Void {
    when slot.socket.fd >= 0 {
        let closed: Int = sock_close(slot.socket);
        // Linux releases the descriptor even if close reports EINTR.
        when closed != 0 && closed != -4 { trap; };
        slot.socket.fd = -1;
    };
    slot.state = 0;
    let finished: Int = now_ns();
    let actual: Int = outcome;
    when finished >= slot.deadline { actual = OUTCOME_TIMEOUT; };
    attempt_finish(slot.attempt,metrics,finished,actual);
};

defn http_attempt_start(slot: HttpAttempt, metrics: OperationMetrics, scheduled: Int, port: Int, timeout: Int) -> Int {
    let started: Int = now_ns();
    when timeout > 9223372036854775807-started { trap; };
    attempt_begin(slot.attempt,metrics,scheduled,started);
    slot.deadline = started+timeout;
    slot.sent = 0; slot.response.len = 0; http_response_reset(slot.frame);
    slot.socket.fd = sock_tcp_nonblocking().fd; slot.state = 1;
    when slot.socket.fd < 0 { http_attempt_finish(slot,metrics,OUTCOME_TRANSPORT); term 0; };
    let connected: Int = sock_connect(slot.socket,ip_v4(127,0,0,1),port);
    when connected == 0 { slot.state = 2; term 0; };
    when connected != -115 && connected != -4 { http_attempt_finish(slot,metrics,OUTCOME_TRANSPORT); };
    term 0;
};

defn http_attempt_read(slot: HttpAttempt, metrics: OperationMetrics, expected: Int) -> Int {
    let available: Int = slot.response.cap-slot.response.len;
    when available == 0 { http_attempt_finish(slot,metrics,OUTCOME_VALIDATION); term 0; };
    let received: Int = sock_recv_once(slot.socket,slot.response,available);
    when received == -11 || received == -4 { term 0; };
    when received < 0 { http_attempt_finish(slot,metrics,OUTCOME_TRANSPORT); term 0; };
    let framed: Int = http_response_progress(slot.frame,slot.response,received == 0);
    when framed == 0 { term 0; };
    when framed < 0 { http_attempt_finish(slot,metrics,OUTCOME_VALIDATION); term 0; };
    when slot.frame.status != 200 { http_attempt_finish(slot,metrics,OUTCOME_APPLICATION); term 0; };
    let body: String = buf_slice_string(slot.response,slot.frame.header_bytes,slot.frame.body_bytes);
    let outcome: Int = OUTCOME_VALIDATION;
    when catalogue_valid(body,expected) { outcome = OUTCOME_OK; };
    // Validation is included in service latency and must obey the deadline too.
    when now_ns() >= slot.deadline { outcome = OUTCOME_TIMEOUT; };
    http_attempt_finish(slot,metrics,outcome);
    term 0;
};

// One bounded send or receive per ready slot per turn keeps large responses from
// starving other slots. HUP can accompany data: read before interpreting EOF.
defn http_attempt_progress(slot: HttpAttempt, metrics: OperationMetrics, request: ByteBuf, events: Int, expected: Int) -> Int {
    when !slot.attempt.active { term 0; };
    when now_ns() >= slot.deadline { http_attempt_finish(slot,metrics,OUTCOME_TIMEOUT); term 0; };
    when events == 0 { term 0; };
    when (events & POLL_INVALID) != 0 { http_attempt_finish(slot,metrics,OUTCOME_TRANSPORT); term 0; };
    when slot.state == 1 {
        when sock_pending_error(slot.socket) != 0 { http_attempt_finish(slot,metrics,OUTCOME_TRANSPORT); term 0; };
        slot.state = 2;
    };
    when slot.state == 2 {
        let sent: Int = sock_send_once(slot.socket,request,slot.sent,request.len-slot.sent);
        when sent == -11 || sent == -4 { term 0; };
        when sent <= 0 { http_attempt_finish(slot,metrics,OUTCOME_TRANSPORT); term 0; };
        slot.sent += sent;
        when slot.sent == request.len { slot.state = 3; };
        term 0;
    };
    http_attempt_read(slot,metrics,expected);
    term 0;
};

defn catalogue_request() -> ByteBuf {
    let text: String = "GET /movies HTTP/1.0\r\nHost: localhost\r\nConnection: close\r\n\r\n";
    let buffer: ByteBuf = buf_new(text .^Length);
    foreach index in 0..text .^Length { Store#(buffer.ptr+index,text[index],1); };
    buffer.len = text .^Length;
    term buffer;
};
