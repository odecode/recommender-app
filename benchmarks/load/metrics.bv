import "std/stats/histogram.bv";

const OUTCOME_OK: Int = 1;
const OUTCOME_APPLICATION: Int = 2;
const OUTCOME_TRANSPORT: Int = 3;
const OUTCOME_TIMEOUT: Int = 4;
const OUTCOME_VALIDATION: Int = 5;

obj AttemptSlot { active: Bool; operation: Int; scheduled_ns: Int; started_ns: Int; };
obj OutcomeLatency { total: Histogram; service: Histogram; };
obj OperationMetrics {
    operation: Int;
    started: Int;
    finished: Int;
    inflight: Int;
    succeeded: Int;
    application_errors: Int;
    transport_errors: Int;
    timed_out: Int;
    validation_errors: Int;
    total_latency: Histogram;
    service_latency: Histogram;
    scheduling_lag: Histogram;
    ok_latency: OutcomeLatency;
    application_latency: OutcomeLatency;
    transport_latency: OutcomeLatency;
    timeout_latency: OutcomeLatency;
    validation_latency: OutcomeLatency;
};

defn outcome_latency(width_ns: Int, buckets: Int) -> OutcomeLatency {
    term OutcomeLatency { total: histogram_new(width_ns,buckets), service: histogram_new(width_ns,buckets) };
};

defn outcome_distribution(metrics: OperationMetrics, outcome: Int) -> OutcomeLatency {
    when outcome == OUTCOME_OK { term metrics.ok_latency; };
    when outcome == OUTCOME_APPLICATION { term metrics.application_latency; };
    when outcome == OUTCOME_TRANSPORT { term metrics.transport_latency; };
    when outcome == OUTCOME_TIMEOUT { term metrics.timeout_latency; };
    when outcome != OUTCOME_VALIDATION { trap; };
    term metrics.validation_latency;
};

defn attempt_slot() -> AttemptSlot {
    term AttemptSlot { active: false, operation: 0, scheduled_ns: 0, started_ns: 0 };
};

defn operation_metrics(operation: Int, width_ns: Int, buckets: Int) -> OperationMetrics {
    when operation < 1 { trap; };
    term OperationMetrics {
        operation: operation, started: 0, finished: 0, inflight: 0, succeeded: 0,
        application_errors: 0, transport_errors: 0, timed_out: 0, validation_errors: 0,
        total_latency: histogram_new(width_ns,buckets),
        service_latency: histogram_new(width_ns,buckets),
        scheduling_lag: histogram_new(width_ns,buckets),
        ok_latency: outcome_latency(width_ns,buckets),
        application_latency: outcome_latency(width_ns,buckets),
        transport_latency: outcome_latency(width_ns,buckets),
        timeout_latency: outcome_latency(width_ns,buckets),
        validation_latency: outcome_latency(width_ns,buckets)
    };
};

// Reuse a slot only after completion. Demand rejected before admission belongs
// to scheduler/admission counters and must not create a started attempt here.
defn attempt_begin(slot: AttemptSlot, metrics: OperationMetrics, scheduled_ns: Int, started_ns: Int) -> Void {
    when slot.active || scheduled_ns < 0 || started_ns < scheduled_ns { trap; };
    when metrics.started == 9223372036854775807 { trap; };
    slot.active = true;
    slot.operation = metrics.operation;
    slot.scheduled_ns = scheduled_ns;
    slot.started_ns = started_ns;
    metrics.started += 1;
    metrics.inflight += 1;
    histogram_record(metrics.scheduling_lag,started_ns-scheduled_ns);
};

// All outcomes contribute latency. A timeout is a failed, completed attempt;
// it must not disappear from the denominator or masquerade as a fast success.
defn attempt_finish(slot: AttemptSlot, metrics: OperationMetrics, finished_ns: Int, outcome: Int) -> Void {
    when !slot.active || slot.operation != metrics.operation || metrics.inflight < 1 { trap; };
    when finished_ns < slot.started_ns || outcome < OUTCOME_OK || outcome > OUTCOME_VALIDATION { trap; };
    histogram_record(metrics.total_latency,finished_ns-slot.scheduled_ns);
    histogram_record(metrics.service_latency,finished_ns-slot.started_ns);
    let distribution: OutcomeLatency = outcome_distribution(metrics,outcome);
    histogram_record(distribution.total,finished_ns-slot.scheduled_ns);
    histogram_record(distribution.service,finished_ns-slot.started_ns);
    metrics.finished += 1;
    metrics.inflight -= 1;
    when outcome == OUTCOME_OK { metrics.succeeded += 1; };
    when outcome == OUTCOME_APPLICATION { metrics.application_errors += 1; };
    when outcome == OUTCOME_TRANSPORT { metrics.transport_errors += 1; };
    when outcome == OUTCOME_TIMEOUT { metrics.timed_out += 1; };
    when outcome == OUTCOME_VALIDATION { metrics.validation_errors += 1; };
    slot.active = false;
};
