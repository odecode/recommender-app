import "./accounts.bv";

obj AccountRating { item_id: Int; rating: Int; timestamp: Int; };
obj AccountState { result: AccountResult; ratings: List<AccountRating>; };

defn account_state_failure(error: String, detail: PgResult) -> AccountState {
    let empty: List<AccountRating> = [];
    term AccountState { result: account_failure(error,detail), ratings: empty };
};

defn account_state_ratings(rows: PgResult, identity: AccountResult, idx: Int, ratings: List<AccountRating>) -> AccountState {
    when idx >= rows.nrows { term AccountState { result: identity, ratings: ratings }; };
    when !(((idx >= 0) && (idx < rows.nrows))) { trap; };
    when !((5 < rows.ncols)) { trap; };
    when !((idx >= 0)) { trap; };
    when !((idx < rows.nrows)) { trap; };
    when !((4 < rows.ncols)) { trap; };
    when !((3 < rows.ncols)) { trap; };
    when !(idx >= 0) { trap; };
    when !(idx < rows.nrows) { trap; };
    when !(2 < rows.ncols) { trap; };

    let owner: Int = pg_row_int(rows,idx,2);
    let item: Int = pg_row_int(rows,idx,3);
    let rating: Int = pg_row_int(rows,idx,4);
    let timestamp: Int = pg_row_int(rows,idx,5);
    when owner != identity.account.id || item < 0 || item >= 1682 || rating < 1 || rating > 5 || timestamp < 0 {
        term account_state_failure("database",store_error("Account ratings do not match their owner or valid bounds; check the database constraints."));
    };
    let row: AccountRating = AccountRating { item_id: item, rating: rating, timestamp: timestamp };
    let added: List<AccountRating> = [row];
    term account_state_ratings(rows,identity,idx + 1,ratings + added);
};

// 2026-10-21: the public state boundary accepts a token, not a claimed ID.
// A single owner-filtered LEFT JOIN snapshots identity and ratings together,
// including a real account with zero ratings. Deleted accounts cannot continue
// using stale sessions. The server adds recommendations for this SAME owner in
// task 12, as confirmed by the human; no fake empty recommendation cache here.
defn account_state(conn: PgConn, sessions: SessionStore, token: String) -> AccountState {
    let id: Int = session_account(sessions,token);
    when id < 1 {
        term account_state_failure("auth-failed",store_error("Session is unknown; log in again."));
    };
    let params: List<String> = [id as String];
    let rows: PgResult = pg_exec(conn,
        "SELECT a.id,a.username,r.account_id,r.item_id,r.rating,r.ts " +
        "FROM accounts a LEFT JOIN ratings r ON r.account_id=a.id " +
        "WHERE a.id=$1::integer ORDER BY r.item_id",params);
    when !rows.ok { term account_state_failure("database",rows); };
    when rows.nrows == 0 {
        term account_state_failure("auth-failed",store_error("Session account no longer exists; log in again."));
    };
    when !((0 < rows.nrows)) { trap; };
    when !((0 < rows.ncols)) { trap; };

    when rows.ncols != 6 || rows.nrows > 1682 || pg_row_int(rows,0,0) != id {
        term account_state_failure("database",store_error("Expected an account-scoped rating snapshot; check the database schema."));
    };
    let identity: AccountResult = AccountResult { ok: true, error: "",
        account: Account { id: id, username: pg_row_text(rows,0,1) }, detail: pg_result_empty() };
    let empty: List<AccountRating> = [];
    // PostgreSQL's absent LEFT JOIN side is NULL; the text client represents
    // it as empty. A real integer account_id can never be empty.
    when pg_row_text(rows,0,2) == "" {
        when rows.nrows != 1 || pg_row_text(rows,0,3) != "" || pg_row_text(rows,0,4) != "" || pg_row_text(rows,0,5) != "" {
            term account_state_failure("database",store_error("Expected an empty rating row for this account; check the database schema."));
        };
        term AccountState { result: identity, ratings: empty };
    };
    term account_state_ratings(rows,identity,0,empty);
};
