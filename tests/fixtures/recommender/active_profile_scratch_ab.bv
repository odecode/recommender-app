import "./active_profile_support.bv";

defn active_gate_allocating_scan(active: ActivePrediction, scores: FloatVector) -> Bool {
    foreach item in 0..scores.len {
        vec_set(scores,item,clamp15(0.5*active_user_prediction(active,item)+0.5*active_item_prediction(active,item)));
    };
    term true;
};

defn active_gate_scratch_ab(engine: ActiveProfileEngine) -> Bool {
    let ratings: List<ProfileRating> = active_gate_ratings(100,0);
    let profile: ActiveProfileEngine = unwrap(active_profile_prepare(engine,2147483000,ratings));
    active_profile_build(profile);
    let compatible: ActivePrediction = ActivePrediction { state: active_gate_state(2147483000,ratings),
        model: engine.model, similarities: engine.scratch.similarities, mean: profile.mean, excluded: profile.excluded };
    let reference: FloatVector = vec_new(engine.model.population.nitems);
    let allocating_us: Int = 0; let reusable_us: Int = 0;
    foreach repeat in 0..10 {
        let started: Int = trace_clock();
        active_gate_allocating_scan(compatible,reference);
        allocating_us = allocating_us+trace_clock()-started;
        started = trace_clock();
        when !active_profile_scores(profile,0.5) { vec_free(reference); term false; };
        reusable_us = reusable_us+trace_clock()-started;
    };
    let valid: Bool = true;
    foreach item in 0..reference.len {
        let error: Float = Fabs#(vec_get(reference,item)-vec_get(engine.scratch.scores,item));
        when !json_finite(error) || error > 0.000001+0.00001*Fabs#(vec_get(reference,item)) { valid = false; };
    };
    let expected: List<Int> = active_gate_reference_rank(reference,ratings);
    let actual: List<RankedMovie> = active_profile_rank(engine.scratch);
    when expected .^Length != actual .^Length { valid = false; };
    foreach idx in 0..expected .^Length { when idx >= actual .^Length || expected[idx] != actual[idx].item_id { valid = false; }; };
    println!("active_scratch_ab pairs=10 allocating_scan_us={} reusable_scan_us={} equivalent={}",allocating_us,reusable_us,valid);
    vec_free(reference);
    term valid;
};
