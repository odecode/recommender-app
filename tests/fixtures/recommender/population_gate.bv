import "../../../examples/recommender/baseline_population.bv";
import "std/env.bv";

defn population_sum_count(values: FloatVector, count: Int, idx: Int, total: Float) -> Float {
    when idx >= count { term total; };
    term population_sum_count(values, count, idx + 1, total + vec_get(values, idx));
};

defn population_small_anchor(pop: RatingPopulation) -> Bool {
    when pop.nnz != 3 { term false; };
    term ivec_get(pop.user_off, 1) == 2 && ivec_get(pop.user_off, 942) == 2 &&
        ivec_get(pop.user_item, 0) == 0 && ivec_get(pop.user_item, 1) == 1 &&
        ivec_get(pop.user_item, 2) == 1681 && vec_get(pop.user_val, 0) == 4.0 &&
        vec_get(pop.user_val, 1) == 3.0 && vec_get(pop.user_val, 2) == 1.0 &&
        ivec_get(pop.item_user, 0) == 0 && ivec_get(pop.item_user, 2) == 942;
};

defn population_gate_run(conn: PgConn, small: Bool) -> Bool {
    let summary: PgResult = pg_simple_query(conn, "SELECT count(*), COALESCE(sum(rating),0) FROM baseline_ratings");
    when summary.ok == false || summary.nrows != 1 || summary.ncols != 2 { term false; };
    let expected: Int = pg_row_int(summary, 0, 0);
    let rating_sum: Float = pg_row_int(summary, 0, 1) as Float;
    let result: Result<RatingPopulation, PgResult> = baseline_population(conn);
    when is_err(result) {
        let failure: PgResult = unwrap_err(result);
        println!("population=false code={} message={}", failure.err_code, failure.err_msg);
        term false;
    };
    let pop: RatingPopulation = unwrap(result);
    let shape_ok: Bool = pop.nusers == 943 && pop.nitems == 1682 && pop.nnz == expected;
    println!("population_shape={} users={} items={} ratings={}", shape_ok, pop.nusers, pop.nitems, pop.nnz);
    let offsets_ok: Bool = ivec_get(pop.user_off, 943) == expected && ivec_get(pop.item_off, 1682) == expected;
    println!("both_orientations_complete={}", offsets_ok);
    let sums_ok: Bool = population_sum_count(pop.user_val, pop.nnz, 0, 0.0) == rating_sum &&
        population_sum_count(pop.item_val, pop.nnz, 0, 0.0) == rating_sum;
    println!("both_rating_sums_match_database={}", sums_ok);
    when small {
        let anchor: Bool = population_small_anchor(pop);
        println!("small_fixture_exact={}", anchor);
        pop_free(pop);
        term shape_ok && offsets_ok && sums_ok && anchor;
    };
    pop_free(pop);
    term shape_ok && offsets_ok && sums_ok;
};

let tick: Int = 0;
node run [tick < 1][tick == 1] {
    let role: String = get_env("PGUSER");
    let database: String = get_env("PGDATABASE");
    let small: Bool = get_env_int("SMALL_FIXTURE") == 1;
    let conn: PgConn = pg_connect(2130706433, 5432, role, database, "");
    when conn.sock.fd < 0 || conn.pid < 0 {
        println!("connect=false");
        when conn.sock.fd >= 0 { sock_close(conn.sock); };
        endprogram 1;
    };
    when small {
        let selected: PgResult = pg_simple_query(conn, "SET search_path TO briev_bootstrap_gate");
        when selected.ok == false { pg_close(conn); endprogram 1; };
    };
    let passed: Bool = population_gate_run(conn, small);
    pg_close(conn);
    when passed == false { endprogram 1; };
    tick = 1;
    endprogram;
};
